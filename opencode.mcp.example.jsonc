{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": [
        "{env:OBSIDIAN_MCP_BIN}",
        "--vault",
        "{env:OBSIDIAN_VAULT}"
      ],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": false
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": false
    }
  }
}
