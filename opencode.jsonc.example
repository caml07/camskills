{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "skill": {
      "*": "allow"
    }
  },
  "plugin": ["@dietrichgebert/ponytail"],
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "obsidian-mcp",
        "{{VAULT_PATH}}"
      ],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{{CONTEXT7_API_KEY}}"
      }
    }
  }
}
